<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTune — Windows Performance Toolkit"
        Height="640" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="HeaderText">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#FF1F1F2E" Padding="10,6">
            <TextBlock x:Name="StatusBarText" Foreground="White" FontSize="12"
                       Text="Ready. Run as Administrator for full cleanup access."/>
        </Border>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#FF2D6CDF" Padding="16,12">
            <StackPanel>
                <TextBlock Text="WinTune" Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Monitor · Clean · Boost — keep your laptop responsive"
                           Foreground="#FFD7E5FF" FontSize="12"/>
            </StackPanel>
        </Border>

        <TabControl Margin="10" Background="Transparent" BorderThickness="0">

            <!-- =========================== DASHBOARD =========================== -->
            <TabItem Header="  Dashboard  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Live system load" Style="{StaticResource HeaderText}"/>

                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="CPU"  VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="DashCpuBar"  Foreground="#FF2D6CDF"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="DashCpuLbl"  Text="0%"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="RAM"  VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="DashRamBar"  Foreground="#FF59A14F"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="DashRamLbl"  Text="0 / 0 GB"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Disk C:" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="2" Grid.Column="1" x:Name="DashDiskBar" Foreground="#FFE15759"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="DashDiskLbl" Text="0 / 0 GB free"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Top 10 processes by RAM" Style="{StaticResource HeaderText}"/>
                        <DataGrid Grid.Row="1" x:Name="DashProcessGrid"
                                  AutoGenerateColumns="True" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  RowBackground="White" AlternatingRowBackground="#FFF2F2F7"
                                  BorderBrush="#FFD0D0DC" BorderThickness="1"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- =========================== CLEAN =========================== -->
            <TabItem Header="  Clean  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Choose what to clean" Style="{StaticResource HeaderText}"/>

                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                        <CheckBox x:Name="ChkUserTemp"      Content="User Temp folder"           IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkSystemTemp"    Content="System Temp folder"         IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkPrefetch"      Content="Windows Prefetch"           IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkWER"           Content="Windows Error Reports"      IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkWindowsUpdate" Content="Windows Update download cache" IsChecked="False" Margin="4"/>
                        <CheckBox x:Name="ChkEdgeCache"     Content="Edge browser cache"         IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkChromeCache"   Content="Chrome browser cache"       IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkFirefoxCache"  Content="Firefox browser cache"      IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkRecycleBin"    Content="Empty Recycle Bin"          IsChecked="True"  Margin="4"/>
                        <CheckBox x:Name="ChkDNSCache"      Content="DNS resolver cache"         IsChecked="True"  Margin="4"/>
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,10">
                        <Button x:Name="CleanRunBtn"      Content="Run Cleanup"        Background="#FF2D6CDF" Foreground="White" FontWeight="SemiBold" Width="160"/>
                        <Button x:Name="CleanSelectAllBtn"  Content="Select all"  Margin="10,4,0,4"/>
                        <Button x:Name="CleanSelectNoneBtn" Content="Clear all"   Margin="6,4,0,4"/>
                        <TextBlock x:Name="CleanTotalLbl" Margin="20,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#FF59A14F"/>
                    </StackPanel>

                    <DataGrid Grid.Row="3" x:Name="CleanResultsGrid"
                              AutoGenerateColumns="True" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowBackground="White" AlternatingRowBackground="#FFF2F2F7"
                              BorderBrush="#FFD0D0DC" BorderThickness="1"/>
                </Grid>
            </TabItem>

            <!-- =========================== BOOST =========================== -->
            <TabItem Header="  Boost  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Quick performance actions" Style="{StaticResource HeaderText}"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="BoostFreeRamBtn"          Content="Free RAM (Empty Working Sets)" Width="240" Background="#FF59A14F" Foreground="White" FontWeight="SemiBold"/>
                        <Button x:Name="BoostRestartExplorerBtn"  Content="Restart Explorer"              Width="160" Margin="10,4,0,4"/>
                        <Button x:Name="BoostFlushDnsBtn"         Content="Flush DNS Cache"               Width="160" Margin="10,4,0,4"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" x:Name="BoostResultLbl" Margin="0,8,0,12"
                               FontFamily="Consolas" Foreground="#FF1F1F2E"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,8">
                        <TextBlock Text="Startup programs (read-only — disable from Task Manager)"
                                   Style="{StaticResource HeaderText}" Margin="0,0,16,0"/>
                        <Button x:Name="BoostOpenTaskMgrBtn" Content="Open Task Manager → Startup" Width="240"/>
                    </StackPanel>

                    <DataGrid Grid.Row="4" x:Name="BoostStartupGrid"
                              AutoGenerateColumns="True" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowBackground="White" AlternatingRowBackground="#FFF2F2F7"
                              BorderBrush="#FFD0D0DC" BorderThickness="1"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
